# Секреты для прод-деплоя (docker-compose.prod.yml).
# Скопируйте в .env на сервере и заполните реальными значениями (в git не коммитится):
#   cp .env.example .env

# Пароль пользователя postgres в БД playslot.
POSTGRES_PASSWORD=change-me-strong-password

# Ключ подписи JWT. Минимум 32 символа. Сгенерировать:
#   openssl rand -base64 48
JWT_KEY=change-me-at-least-32-chars-long-secret

# Разрешённые origins для CORS (через запятую). По умолчанию https://play.hypex.site.
CORS_ALLOWED_ORIGINS=https://play.hypex.site

# Telegram-уведомления о бронях (опционально — оставьте пустым, чтобы отключить).
#   BOT_TOKEN — получить у @BotFather
#   ADMIN_CHAT_ID — id чата/группы, куда слать уведомления (узнать у @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
